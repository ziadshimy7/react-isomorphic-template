{
  "name": "react-ssr-template",
  "version": "1.0.0",
  "description": "React SSR template with Vite, Tailwind, and streaming",
  "scripts": {
    "dev": "tsx server.tsx",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client --manifest --mode production",
    "build:server": "vite build --outDir dist/server --ssr packages/server/entry-server.ts --mode production",
    "start": "cross-env NODE_ENV=production tsx server.tsx"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/express": "^4.17.17",
    "@types/react": "^18.2.6",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@vitejs/plugin-react": "^5.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.38.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^2.8.8",
    "sass": "^1.62.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.5",
    "axios": "^1.13.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.2",
    "react-router-dom": "^6.11.2",
    "tailwind-merge": "^3.4.0"
  }
}
